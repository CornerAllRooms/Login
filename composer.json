{
    "name": "your-project/production",
    "description": "Production environment configuration",
    "type": "project",
    "require": {
        "php": "^8.3.6",
        "ext-mongodb": "^1.17",
        "mongodb/mongodb": "^1.17",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.8",
        "ramsey/uuid": "^4.7",
        "paragonie/random_compat": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "my-login-backend"
        },
        "files": [
            "my-login-backend/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "my-login-backend/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.6"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-install-cmd": [
            "@composer dump-autoload -o"
        ],
        "post-update-cmd": [
            "@composer dump-autoload -o"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}